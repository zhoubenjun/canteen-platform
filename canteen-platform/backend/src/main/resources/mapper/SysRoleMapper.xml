<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canteen.mapper.SysRoleMapper">
    <select id="list" resultType="com.canteen.entity.SysRole">SELECT * FROM sys_role ORDER BY id</select>
    <select id="findById" resultType="com.canteen.entity.SysRole">SELECT * FROM sys_role WHERE id = #{id}</select>
    <select id="findByName" resultType="com.canteen.entity.SysRole">SELECT * FROM sys_role WHERE role_name = #{roleName}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role(role_name) VALUES(#{roleName})
    </insert>
    <delete id="delete">DELETE FROM sys_role WHERE id = #{id}</delete>
</mapper>
