<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canteen.mapper.CompanionMapper">
    <resultMap id="companionMap" type="com.canteen.entity.Companion">
        <id property="id" column="id"/>
        <result property="schoolName" column="school_name"/>
        <result property="companionDate" column="companion_date"/>
        <result property="week" column="week"/>
        <result property="mealType" column="meal_type"/>
        <result property="dishName" column="dish_name"/>
        <result property="companionName" column="companion_name"/>
        <result property="companionIdentity" column="companion_identity"/>
        <result property="rating" column="rating"/>
        <result property="comment" column="comment"/>
        <result property="createdTime" column="created_time"/>
    </resultMap>

    <sql id="whereClause">
        <where>
            <if test="name != null and name != ''">
                AND companion_name LIKE CONCAT('%',#{name},'%')
            </if>
            <if test="start != null and start != ''">
                AND companion_date &gt;= #{start}
            </if>
            <if test="end != null and end != ''">
                AND companion_date &lt;= #{end}
            </if>
            <if test="mealType != null and mealType != ''">
                AND meal_type = #{mealType}
            </if>
        </where>
    </sql>

    <select id="page" resultMap="companionMap">
        SELECT * FROM companion
        <include refid="whereClause"/>
        ORDER BY id
        LIMIT #{offset}, #{size}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM companion
        <include refid="whereClause"/>
    </select>

    <select id="listAll" resultMap="companionMap">
        SELECT * FROM companion ORDER BY id
    </select>

    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO companion
            (school_name, companion_date, week, meal_type, dish_name,
             companion_name, companion_identity, rating, `comment`, created_time)
        VALUES
        <foreach collection="list" item="c" separator=",">
            (#{c.schoolName}, #{c.companionDate}, #{c.week}, #{c.mealType}, #{c.dishName},
             #{c.companionName}, #{c.companionIdentity}, #{c.rating}, #{c.comment}, #{c.createdTime})
        </foreach>
    </insert>

    <delete id="deleteAll">DELETE FROM companion</delete>

    <delete id="deleteByMonth">
        DELETE FROM companion WHERE companion_date LIKE CONCAT(#{month}, '-%')
    </delete>
</mapper>
