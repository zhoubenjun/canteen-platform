<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canteen.mapper.AnalysisMapper">
    <resultMap id="analysisMap" type="com.canteen.entity.PaymentAnalysis">
        <id property="id" column="id"/>
        <result property="companionName" column="companion_name"/>
        <result property="companionDate" column="companion_date"/>
        <result property="mealType" column="meal_type"/>
        <result property="paid" column="paid"/>
    </resultMap>

    <sql id="whereClause">
        <where>
            <if test="name != null and name != ''">
                AND companion_name LIKE CONCAT('%',#{name},'%')
            </if>
            <if test="start != null and start != ''">
                AND companion_date &gt;= #{start}
            </if>
            <if test="end != null and end != ''">
                AND companion_date &lt;= #{end}
            </if>
            <if test="mealType != null and mealType != ''">
                AND meal_type = #{mealType}
            </if>
            <if test="paid != null and paid != ''">
                AND paid = #{paid}
            </if>
        </where>
    </sql>

    <select id="page" resultMap="analysisMap">
        SELECT * FROM payment_analysis
        <include refid="whereClause"/>
        ORDER BY id
        LIMIT #{offset}, #{size}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM payment_analysis
        <include refid="whereClause"/>
    </select>

    <select id="listFiltered" resultMap="analysisMap">
        SELECT * FROM payment_analysis
        <include refid="whereClause"/>
        ORDER BY id
    </select>

    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payment_analysis
            (companion_name, companion_date, meal_type, paid)
        VALUES
        <foreach collection="list" item="a" separator=",">
            (#{a.companionName}, #{a.companionDate}, #{a.mealType}, #{a.paid})
        </foreach>
    </insert>

    <delete id="deleteAll">DELETE FROM payment_analysis</delete>

    <delete id="deleteByMonth">
        DELETE FROM payment_analysis WHERE companion_date LIKE CONCAT(#{month}, '-%')
    </delete>
</mapper>
